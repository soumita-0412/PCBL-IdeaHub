# ============================================================
# IDEAS PORTAL — Backend Environment Variables
# Copy to .env and fill in values.
# NEVER commit the actual .env file.
# ============================================================

# ─── Application ───────────────────────────────────────────
APP_ENV=development
APP_NAME=Ideas Portal API
APP_VERSION=0.1.0
DEBUG=true

# ─── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── MongoDB ───────────────────────────────────────────────
MONGODB_URL=mongodb://admin:changeme@localhost:27017/ideas_portal?authSource=admin
MONGODB_DATABASE=ideas_portal
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ─── JWT (Phase 1 — HS256 credential auth) ─────────────────
# CHANGE THIS in UAT/Production — use a long random secret
JWT_SECRET_KEY=dev-secret-change-in-production-use-random-256-bit-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Azure AD (Phase 2+ SSO — leave blank for Phase 1) ─────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
JWT_AUDIENCE=

# ─── Microsoft Graph API (Phase 2+) ────────────────────────
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ─── Storage (Azure Blob — Phase 2+) ───────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=ideas-attachments

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── Email / Notifications (via Graph API Mail.send) ───────
# Notifications are sent through Microsoft Graph API using the
# same GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET credentials above.
# No separate SMTP config required.
