# ============================================================
# IDEAS PORTAL — Root Environment Variables Example
# Copy to .env and fill in values.
# NEVER commit the actual .env file.
# ============================================================

# ─── Deployment Target ─────────────────────────────────────
# Options: development | uat | production
APP_ENV=development

# ─── Docker Compose Profiles ───────────────────────────────
COMPOSE_PROJECT_NAME=ideas-portal
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml

# ─── Frontend Service ──────────────────────────────────────
FRONTEND_PORT=3000

# ─── Backend Service ───────────────────────────────────────
BACKEND_PORT=8000

# ─── MongoDB ───────────────────────────────────────────────
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=ideas_portal

# ─── Internal Service URLs (Docker network) ────────────────
INTERNAL_FRONTEND_URL=http://frontend:3000
INTERNAL_BACKEND_URL=http://backend:8000
