# ============================================================
# IDEAS PORTAL — Frontend Environment Variables
# Copy to .env.local and fill in values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# NEVER commit .env.local.
# ============================================================

# ─── Application ───────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0

# ─── API Configuration ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_TIMEOUT=30000

# ─── Microsoft Entra ID (Phase 2+ SSO — leave blank for Phase 1) ──
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_REDIRECT_URI=
NEXT_PUBLIC_AZURE_POST_LOGOUT_REDIRECT_URI=

# ─── Feature Flags ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEVTOOLS=true
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true

# ─── Logging ───────────────────────────────────────────────
NEXT_PUBLIC_LOG_LEVEL=debug
